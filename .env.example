# Groq API key for generation and grading
GROQ_API_KEY=
# Google Gemini API key for embeddings and evaluation judge
GOOGLE_API_KEY=
# Cohere API key for reranking
COHERE_API_KEY=
# Tavily API key for web search fallback (corrective RAG, M10)
TAVILY_API_KEY=
# Corrective RAG settings (optional; defaults in ragdocs.config.Settings):
# WEB_MAX_RESULTS=3        Tavily results per web search, docs domain only (D8)
# MIN_RELEVANT_CHUNKS=1    fewer graded-relevant chunks than this triggers correction
# MAX_QUERY_REWRITES=1     query rewrites allowed per question
# Upstash Redis REST URL for rate limiting
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token for rate limiting
UPSTASH_REDIS_REST_TOKEN=
# local | production
RAGDOCS_ENV=
# LangSmith tracing: true | false. Must not be empty (an empty value fails Settings validation)
LANGSMITH_TRACING=false
# LangSmith API key (required when LANGSMITH_TRACING=true)
LANGSMITH_API_KEY=
# LangSmith project name (default ragdocs-local)
LANGSMITH_PROJECT=ragdocs-local
# LangSmith API URL; leave empty for the US default, set for other regions
LANGSMITH_ENDPOINT=
# Fraction of traces sent, 0 to 1 (default 1.0; production must use 0.1 or lower, see D18)
LANGSMITH_TRACING_SAMPLING_RATE=1.0
